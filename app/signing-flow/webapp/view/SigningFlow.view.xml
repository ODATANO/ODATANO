<mvc:View
    controllerName="odatanoview.signingflow.controller.SigningFlow"
    displayBlock="true"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Page id="signingFlowPage" showHeader="true" enableScrolling="true">
        <customHeader>
            <Bar>
                <contentLeft>
                    <HBox alignItems="Center" visible="{wallet>/isConnected}">
                        <core:Icon src="{wallet>/walletIcon}" size="1.5rem" class="sapUiSmallMarginEnd"
                            visible="{= !!${wallet>/walletIcon}}" />
                        <Title text="{wallet>/walletName}" level="H5" class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{wallet>/networkName}"
                            state="{= ${wallet>/networkName} === 'Mainnet' ? 'Success' : 'Warning'}"
                            icon="sap-icon://connected" class="sapUiSmallMarginEnd" />
                    </HBox>
                    <Title text="{i18n>headerTitle}" level="H5" visible="{= !${wallet>/isConnected}}" />
                </contentLeft>
                <contentMiddle>
                    <Text text="{path: 'wallet>/addresses/0/bech32', formatter: '.formatter.truncateAddress'}"
                        class="signingFlowMono"
                        visible="{wallet>/isConnected}" />
                </contentMiddle>
                <contentRight>
                    <Button icon="sap-icon://copy" tooltip="{i18n>copy}" press=".onCopyAddress"
                        type="Transparent" visible="{wallet>/isConnected}" />
                    <Button icon="sap-icon://refresh" tooltip="{i18n>headerRefresh}" press=".onRefreshWallet"
                        type="Transparent" visible="{wallet>/isConnected}" />
                    <Button text="{i18n>headerDisconnect}" press=".onDisconnect"
                        type="Transparent" visible="{wallet>/isConnected}" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Wallet Connect Panel (not connected) -->
            <VBox visible="{= !${wallet>/isConnected}}" class="walletConnectPanel">
                <core:Icon src="sap-icon://key-user-settings" size="4rem" color="#0854a0"
                    class="sapUiMediumMarginBottom" />
                <Title text="{i18n>walletConnectTitle}" level="H2" class="sapUiSmallMarginBottom" />
                <Text text="{i18n>walletConnectDescription}" class="sapUiSmallMarginBottom" />

                <BusyIndicator visible="{wallet>/isConnecting}" size="2rem"
                    text="{i18n>walletConnecting}" class="sapUiMediumMarginTop" />

                <MessageStrip text="{wallet>/error}" type="Error"
                    visible="{= !!${wallet>/error}}" showCloseButton="true"
                    class="sapUiSmallMarginTop" />

                <List items="{wallet>/availableWallets}" mode="SingleSelectMaster"
                    selectionChange=".onWalletSelect" visible="{= !${wallet>/isConnecting}}"
                    noDataText="{i18n>walletConnectHint}">
                    <CustomListItem type="Active">
                        <HBox alignItems="Center" class="sapUiSmallMargin">
                            <core:Icon src="{wallet>icon}" size="1.5rem" class="sapUiSmallMarginEnd"
                                visible="{= !!${wallet>icon}}" />
                            <VBox>
                                <Text text="{wallet>name}" class="sapUiSmallMarginEnd" />
                                <Text text="CIP-30 v{wallet>apiVersion}" class="sapUiTinyMarginTop" />
                            </VBox>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>

            <!-- Connected: Wizard + Panels -->
            <VBox visible="{wallet>/isConnected}">

                <!-- Balance info bar -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                    <ObjectNumber number="{path: 'wallet>/balance/lovelace', formatter: '.formatter.formatLovelaceToAda'}"
                        unit="ADA" state="Success" />
                    <ObjectStatus text="{wallet>/networkName}"
                        state="{= ${wallet>/networkName} === 'Mainnet' ? 'Success' : 'Warning'}" />
                </HBox>

                <!-- Main Wizard -->
                <Wizard id="signingWizard" class="signingFlowWizard"
                    renderMode="Page" backgroundDesign="Standard">

                    <WizardStep id="stepBuild"
                        title="{i18n>stepBuildTitle}"
                        icon="sap-icon://build"
                        validated="{flow>/buildCompleted}">
                        <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.StepBuild" type="XML" />
                    </WizardStep>

                    <WizardStep id="stepSign"
                        title="{i18n>stepSignTitle}"
                        icon="sap-icon://signature"
                        validated="{flow>/signCompleted}"
                        activate=".onStepSignActivate">
                        <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.StepSign" type="XML" />
                    </WizardStep>

                    <WizardStep id="stepVerify"
                        title="{i18n>stepVerifyTitle}"
                        icon="sap-icon://accept"
                        validated="{flow>/verifyCompleted}"
                        activate=".onStepVerifyActivate">
                        <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.StepVerify" type="XML" />
                    </WizardStep>

                    <WizardStep id="stepSubmit"
                        title="{i18n>stepSubmitTitle}"
                        icon="sap-icon://upload-to-cloud">
                        <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.StepSubmit" type="XML" />
                    </WizardStep>
                </Wizard>

                <!-- Signing Request History -->
                <Panel headerText="{i18n>historyTitle}" expandable="true" expanded="false"
                    class="sapUiSmallMarginTop sapUiSmallMarginBeginEnd">
                    <List items="{flow>/signingRequests}" noDataText="{i18n>historyEmpty}"
                        class="historyList">
                        <CustomListItem type="Active" press=".onHistoryItemPress">
                            <HBox alignItems="Center" justifyContent="SpaceBetween"
                                width="100%" class="sapUiTinyMargin">
                                <VBox>
                                    <Text text="{path: 'flow>id', formatter: '.formatter.truncateHash'}"
                                        class="signingFlowMono" />
                                    <Text text="{path: 'flow>createdAt', formatter: '.formatter.formatTimestamp'}"
                                        class="sapUiTinyMarginTop" />
                                </VBox>
                                <ObjectStatus
                                    text="{flow>status}"
                                    state="{path: 'flow>status', formatter: '.formatter.getSigningRequestStatusState'}"
                                    icon="{path: 'flow>status', formatter: '.formatter.getSigningRequestStatusIcon'}" />
                            </HBox>
                        </CustomListItem>
                    </List>
                </Panel>

                <!-- Transaction Inspector -->
                <Panel headerText="{i18n>inspectorTitle}" expandable="true" expanded="false"
                    visible="{= !!${flow>/build}}"
                    class="sapUiTinyMarginTop sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
                    <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.TransactionInspector" type="XML" />
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
