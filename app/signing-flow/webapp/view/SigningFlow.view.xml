<mvc:View
    controllerName="odatanoview.signingflow.controller.SigningFlow"
    displayBlock="true"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Page id="signingFlowPage" showHeader="true" enableScrolling="true">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="{i18n>headerTitle}"/>
                </contentMiddle>
                <contentRight>
                    <Button text="{i18n>headerDisconnect}" press=".onDisconnect"
                        type="Transparent" visible="{wallet>/isConnected}" />
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Wallet Connect Panel (not connected) -->
            <core:Fragment fragmentName="odatano.common.wallet.WalletConnect" type="XML"/>

            <!-- Connected: Tab-based Signing Request Management -->
            <VBox visible="{wallet>/isConnected}" class="sapUiSmallMargin">

                <!-- Wallet Info Header with Address -->
                <core:Fragment fragmentName="odatano.common.wallet.WalletHeader" type="XML"/>

                <!-- Main Tab Bar -->
                <IconTabBar id="mainTabBar" select=".onTabSelect"
                    selectedKey="{flow>/selectedTab}"
                    class="signingFlowTabs"
                    stretchContentHeight="false">
                    <items>
                        <!-- Build Tab -->
                        <IconTabFilter text="{i18n>tabBuild}" icon="sap-icon://wrench" key="build">
                            <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.TabBuild" type="XML" />
                        </IconTabFilter>

                        <!-- Pending Tab -->
                        <IconTabFilter text="{i18n>tabPending}" icon="sap-icon://pending" key="pending"
                            count="{flow>/counts/pending}">
                            <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.TabPending" type="XML" />
                        </IconTabFilter>

                        <!-- Verified Tab -->
                        <IconTabFilter text="{i18n>tabVerified}" icon="sap-icon://accept" key="verified"
                            count="{flow>/counts/verified}">
                            <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.TabVerified" type="XML" />
                        </IconTabFilter>

                        <!-- Submitted Tab -->
                        <IconTabFilter text="{i18n>tabSubmitted}" icon="sap-icon://upload-to-cloud" key="submitted"
                            count="{flow>/counts/submitted}">
                            <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.TabSubmitted" type="XML" />
                        </IconTabFilter>
                    </items>
                </IconTabBar>

                <!-- Transaction Inspector -->
                <Panel headerText="{i18n>inspectorTitle}" expandable="true" expanded="false"
                    visible="{= !!${flow>/build} || !!${flow>/selectedRequest}}"
                    class="sapUiTinyMarginTop sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
                    <core:Fragment fragmentName="odatanoview.signingflow.view.fragment.TransactionInspector" type="XML" />
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
