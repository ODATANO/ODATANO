<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <VBox>
        <!-- Refresh Bar -->
        <Toolbar class="sapUiSmallMarginBottom">
            <Title text="{i18n>tabVerified}" level="H4" />
            <ToolbarSpacer/>
            <Button icon="sap-icon://refresh" press=".onRefreshRequests"
                type="Transparent" tooltip="{i18n>refreshRequests}" />
        </Toolbar>

        <!-- Empty State -->
        <VBox visible="{= !${flow>/requests/verified} || ${flow>/requests/verified}.length === 0}"
            alignItems="Center" class="sapUiLargeMarginTop">
            <core:Icon src="sap-icon://accept" size="3rem" color="#6a6d70" class="sapUiSmallMarginBottom" />
            <Title text="{i18n>verifiedEmpty}" level="H4" />
        </VBox>

        <!-- Request List -->
        <List id="verifiedList"
            items="{flow>/requests/verified}"
            mode="SingleSelectMaster"
            selectionChange=".onVerifiedRequestSelect"
            visible="{= ${flow>/requests/verified}.length > 0}">
            <CustomListItem type="Active">
                <HBox alignItems="Center" justifyContent="SpaceBetween"
                    width="100%" class="sapUiTinyMargin">
                    <VBox>
                        <Text text="{path: 'flow>id', formatter: '.formatter.truncateHash'}"
                            class="signingFlowMono" />
                        <Text text="{path: 'flow>createdAt', formatter: '.formatter.formatTimestamp'}"
                            class="sapUiTinyMarginTop" />
                    </VBox>
                    <VBox alignItems="End">
                        <ObjectStatus text="Verified" state="Success" icon="sap-icon://accept" />
                        <Text text="{flow>network}" class="sapUiTinyMarginTop" />
                    </VBox>
                </HBox>
            </CustomListItem>
        </List>

        <!-- Detail Area: shown when a verified request is selected -->
        <VBox visible="{= !!${flow>/selectedRequest} &amp;&amp; ${flow>/selectedRequest/status} === 'verified'}"
            class="sapUiSmallMarginTop requestDetail">

            <!-- Verification Summary -->
            <VBox class="verificationResult verificationSuccess" alignItems="Center">
                <core:Icon src="sap-icon://accept" size="3rem" color="#107e3e" />
                <Title text="{i18n>verifyValid}" level="H3" class="sapUiSmallMarginTop" />
            </VBox>

            <!-- Verification Details -->
            <f:SimpleForm editable="false" layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                class="sapUiSmallMarginTop">

                <Label text="{i18n>verifyWitnessCount}" />
                <ObjectNumber number="{flow>/selectedRequest/verification/witnessCount}" unit="signature(s)"
                    state="{= ${flow>/selectedRequest/verification/witnessCount} > 0 ? 'Success' : 'Error'}" />

                <Label text="{i18n>verifyTxBodyHash}" />
                <HBox alignItems="Center">
                    <Text text="{path: 'flow>/selectedRequest/txBodyHash', formatter: '.formatter.truncateHash'}"
                        class="signingFlowMono" />
                    <Button icon="sap-icon://copy" press=".onCopySelectedTxHash"
                        type="Transparent" class="copyInline" tooltip="{i18n>copy}" />
                </HBox>

                <Label text="{i18n>verifySignerKeys}"
                    visible="{= ${flow>/selectedRequest/verification/signerKeyHashes} &amp;&amp; ${flow>/selectedRequest/verification/signerKeyHashes}.length > 0}" />
                <VBox visible="{= ${flow>/selectedRequest/verification/signerKeyHashes} &amp;&amp; ${flow>/selectedRequest/verification/signerKeyHashes}.length > 0}">
                    <List items="{flow>/selectedRequest/verification/signerKeyHashes}">
                        <CustomListItem>
                            <HBox alignItems="Center" class="sapUiTinyMargin">
                                <core:Icon src="sap-icon://key" class="sapUiSmallMarginEnd" />
                                <Text text="{flow>}" class="keyHashItem" />
                                <Button icon="sap-icon://copy" press=".onCopyKeyHash"
                                    type="Transparent" class="copyInline" tooltip="{i18n>copy}" />
                            </HBox>
                        </CustomListItem>
                    </List>
                </VBox>

                <Label text="{i18n>submitNetwork}" />
                <ObjectStatus text="{flow>/selectedRequest/network}"
                    state="{= ${flow>/selectedRequest/network} === 'mainnet' ? 'Success' : 'Warning'}" />
            </f:SimpleForm>

            <!-- Submit Button -->
            <HBox justifyContent="Center" class="sapUiMediumMarginTop">
                <Button text="{i18n>submitButton}" icon="sap-icon://upload-to-cloud"
                    type="Emphasized" press=".onSubmitSelectedTransaction"
                    busy="{flow>/submitBusy}" busyIndicatorDelay="0" />
            </HBox>

            <!-- Submit Error -->
            <MessageStrip text="{flow>/submitError}" type="Error"
                visible="{= !!${flow>/submitError}}" showCloseButton="true"
                class="sapUiSmallMarginTop sapUiSmallMarginBeginEnd" />
        </VBox>
    </VBox>
</core:FragmentDefinition>
