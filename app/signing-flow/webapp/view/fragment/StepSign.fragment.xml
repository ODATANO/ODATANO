<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox>
        <!-- Signing Request Header -->
        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin stepHeader"
            visible="{= !!${flow>/signingRequest}}">
            <HBox alignItems="Center">
                <Label text="{i18n>signRequestId}:" class="sapUiSmallMarginEnd" />
                <Text text="{path: 'flow>/signingRequest/id', formatter: '.formatter.truncateHash'}"
                    class="signingFlowMono" />
                <Button icon="sap-icon://copy" press=".onCopySigningRequestId"
                    type="Transparent" class="copyInline" tooltip="{i18n>copy}" />
            </HBox>
            <HBox alignItems="Center">
                <ObjectStatus text="{flow>/signingRequest/status}"
                    state="{path: 'flow>/signingRequest/status', formatter: '.formatter.getSigningRequestStatusState'}"
                    icon="{path: 'flow>/signingRequest/status', formatter: '.formatter.getSigningRequestStatusIcon'}"
                    class="sapUiSmallMarginEnd" />
                <ObjectStatus text="{flow>/expirationText}"
                    state="{flow>/expirationState}"
                    icon="sap-icon://fob-watch"
                    class="expirationCountdown" />
            </HBox>
        </HBox>

        <!-- Signing Tabs -->
        <IconTabBar id="signTabBar" selectedKey="wallet"
            visible="{= !!${flow>/signingRequest}}">

            <!-- Browser Wallet Tab -->
            <items>
                <IconTabFilter text="{i18n>signWalletTab}" icon="sap-icon://iphone" key="wallet">
                    <VBox class="signTabContent">
                        <!-- Wallet Info -->
                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                            <core:Icon src="{wallet>/walletIcon}" size="2rem" class="sapUiSmallMarginEnd"
                                visible="{= !!${wallet>/walletIcon}}" />
                            <VBox>
                                <Text text="{wallet>/walletName}" />
                                <ObjectStatus text="{wallet>/networkName}"
                                    state="{= ${wallet>/networkName} === 'Mainnet' ? 'Success' : 'Warning'}" />
                            </VBox>
                        </HBox>

                        <!-- Network Mismatch Warning -->
                        <MessageStrip type="Warning"
                            text="{i18n>signNetworkMismatch}"
                            visible="{flow>/networkMismatch}"
                            class="sapUiSmallMarginBottom" />

                        <!-- Sign Button -->
                        <Button text="{= 'Sign with ' + ${wallet>/walletName}}"
                            icon="sap-icon://signature"
                            type="Emphasized"
                            press=".onSignWithWallet"
                            enabled="{= !${flow>/signBusy} &amp;&amp; !${flow>/signCompleted} &amp;&amp; ${flow>/expirationState} !== 'Error'}"
                            busyIndicatorDelay="0"
                            busy="{flow>/signBusy}"
                            class="sapUiSmallMarginBottom" />

                        <!-- Status Messages -->
                        <MessageStrip text="{flow>/signMessage}" type="{flow>/signMessageType}"
                            visible="{= !!${flow>/signMessage}}" showCloseButton="true" />
                    </VBox>
                </IconTabFilter>

                <!-- Manual / CLI Tab -->
                <IconTabFilter text="{i18n>signCliTab}" icon="sap-icon://terminal" key="cli">
                    <VBox class="signTabContent">
                        <!-- CLI Command Section -->
                        <Title text="{i18n>signCliTitle}" level="H5" class="sapUiSmallMarginBottom" />
                        <Text text="{i18n>signCliDescription}" class="sapUiSmallMarginBottom" />

                        <VBox class="cliCommandBox">
                            <TextArea value="{flow>/signingRequest/cardanoCliCommand}"
                                editable="false" rows="3" width="100%" growing="true" />
                        </VBox>
                        <Button text="{i18n>signCliCopy}" icon="sap-icon://copy"
                            press=".onCopyCliCommand" type="Transparent"
                            class="sapUiSmallMarginBottom" />

                        <!-- Paste Signed CBOR -->
                        <Title text="{i18n>signPasteTitle}" level="H5"
                            class="sapUiMediumMarginTop sapUiSmallMarginBottom" />
                        <TextArea value="{flow>/manualCborInput}"
                            placeholder="{i18n>signPastePlaceholder}"
                            rows="5" width="100%" growing="true"
                            class="signingFlowMono"
                            enabled="{= !${flow>/signCompleted} &amp;&amp; ${flow>/expirationState} !== 'Error'}" />
                        <Button text="{i18n>signPasteButton}" icon="sap-icon://accept"
                            type="Emphasized" press=".onSubmitManualCbor"
                            enabled="{= !!${flow>/manualCborInput} &amp;&amp; !${flow>/signCompleted} &amp;&amp; ${flow>/expirationState} !== 'Error'}"
                            class="sapUiSmallMarginTop" />

                        <!-- Manual CBOR Error -->
                        <MessageStrip text="{flow>/manualCborError}" type="Error"
                            visible="{= !!${flow>/manualCborError}}" showCloseButton="true"
                            class="sapUiSmallMarginTop" />
                    </VBox>
                </IconTabFilter>
            </items>
        </IconTabBar>

        <!-- Sign Success Indicator -->
        <MessageStrip text="{i18n>signWalletSuccess}" type="Success"
            visible="{flow>/signCompleted}" class="sapUiSmallMarginTop" />
    </VBox>
</core:FragmentDefinition>
