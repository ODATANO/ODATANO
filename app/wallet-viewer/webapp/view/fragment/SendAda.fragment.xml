<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog
        id="sendAdaDialog"
        title="Send ADA"
        contentWidth="400px">

        <content>
            <VBox class="sapUiSmallMargin">
                <!-- Sender info -->
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <core:Icon src="sap-icon://wallet" class="sapUiSmallMarginEnd"/>
                    <VBox>
                        <Label text="From" design="Bold"/>
                        <Text text="{parts: ['sendModel>/senderAddress'], formatter: '.formatter.truncateAddress'}"/>
                    </VBox>
                </HBox>

                <form:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="3"
                    labelSpanS="12">

                    <Label text="Recipient" required="true"/>
                    <Input
                        id="recipientAddressInput"
                        value="{sendModel>/recipientAddress}"
                        placeholder="addr1... or addr_test1..."
                        valueLiveUpdate="true"
                        liveChange=".onRecipientAddressChange"
                        valueState="{sendModel>/recipientAddressState}"
                        valueStateText="{sendModel>/recipientAddressStateText}"/>

                    <Label text="Amount (ADA)" required="true"/>
                    <Input
                        id="amountInput"
                        value="{sendModel>/adaAmount}"
                        type="Number"
                        placeholder="e.g. 10"
                        valueLiveUpdate="true"
                        liveChange=".onAmountChange"
                        valueState="{sendModel>/amountState}"
                        valueStateText="{sendModel>/amountStateText}"/>

                </form:SimpleForm>

                <!-- Available balance info -->
                <HBox justifyContent="End" class="sapUiSmallMarginTop">
                    <Text text="Available: "/>
                    <ObjectNumber
                        number="{= Math.floor(Number(${sendModel>/availableBalance} || 0) / 1000000 * 100) / 100 }"
                        unit="ADA"
                        class="sapUiTinyMarginBegin"/>
                </HBox>

                <!-- Error display -->
                <MessageStrip
                    text="{sendModel>/error}"
                    type="Error"
                    showIcon="true"
                    visible="{= !!${sendModel>/error}}"
                    class="sapUiSmallMarginTop"/>
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Continue"
                type="Emphasized"
                press=".onContinueSend"
                enabled="{sendModel>/canContinue}"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelSend"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
