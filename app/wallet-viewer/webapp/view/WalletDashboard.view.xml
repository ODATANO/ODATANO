<mvc:View
    controllerName="odatanoview.walletviewer.controller.WalletDashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="walletDashboardPage"
        title="Cardano Wallet"
        showNavButton="false">

        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="Cardano Wallet"/>
                </contentMiddle>
                <contentRight>
                    <Button
                        text="Disconnect"
                        type="Transparent"
                        press=".onDisconnect"
                        visible="{wallet>/isConnected}"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <!-- Not Connected State -->
            <core:Fragment fragmentName="odatano.common.wallet.WalletConnect" type="XML"/>

            <!-- Connected State - Wallet Dashboard -->
            <VBox
                id="connectedBox"
                visible="{wallet>/isConnected}"
                class="sapUiSmallMargin">

                <!-- Wallet Info Header with Address -->
                <core:Fragment fragmentName="odatano.common.wallet.WalletHeader" type="XML"/>

                <!-- Balance Card -->
                <Panel headerText="Balance" expandable="false" class="sapUiTinyMarginTop">
                    <content>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                            <VBox>
                                <ObjectNumber
                                    number="{= Math.floor(Number(${wallet>/balance/lovelace} || 0) / 1000000 * 100) / 100 }"
                                    unit="ADA"
                                    emphasized="true"
                                    state="Information"/>
                                <Text text="{= (${wallet>/balance/lovelace} || '0') + ' lovelace'}"/>
                            </VBox>
                            <Button
                                text="Send ADA"
                                icon="sap-icon://initiative"
                                type="Emphasized"
                                press=".onSendAda"/>
                        </HBox>

                    </content>
                </Panel>

                <!-- HSM Signing Module -->
                <Panel expandable="true" expanded="false"
                       visible="{hsm>/connected}"
                       class="sapUiTinyMarginTop">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="HSM Signing Module" level="H5"/>
                            <ToolbarSpacer/>
                            <ObjectStatus text="Connected" state="Success" icon="sap-icon://connected"/>
                            <Button icon="sap-icon://refresh" type="Transparent" press=".onRefreshHsmStatus" tooltip="Refresh HSM Status"/>
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <Label text="Key Label:" class="sapUiSmallMarginEnd"/>
                                <Text text="{hsm>/keyLabel}"/>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <Label text="Key ID:" class="sapUiSmallMarginEnd"/>
                                <Text text="{hsm>/keyId}"/>
                            </HBox>
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <Label text="Public Key Hash:" class="sapUiSmallMarginEnd"/>
                                <Text text="{parts: ['hsm>/publicKeyHash'], formatter: '.formatter.truncateHash'}"/>
                            </HBox>
                            <HBox alignItems="Center">
                                <Label text="Address:" class="sapUiSmallMarginEnd"/>
                                <Text text="{parts: ['hsm>/cardanoAddress'], formatter: '.formatter.truncateAddress'}"/>
                            </HBox>
                        </VBox>
                    </content>
                </Panel>

                <!-- Native Assets -->
                <Panel
                    headerText="{= 'Native Assets (' + (${wallet>/balance/assets}.length || 0) + ')'}"
                    expandable="true"
                    expanded="false"
                    visible="{= ${wallet>/balance/assets}.length > 0 }"
                    class="sapUiTinyMarginTop">
                    <content>
                        <List items="{wallet>/balance/assets}" noDataText="No native assets">
                            <StandardListItem
                                type="Active"
                                press=".onAssetItemPress"
                                title="{wallet>displayName}"
                                description="{= 'Policy: ' + ${wallet>policyId}.substring(0, 12) + '...' + ${wallet>policyId}.slice(-8)}"
                                info="{wallet>quantity}"
                                infoState="Success"/>
                        </List>
                    </content>
                </Panel>


                <Panel headerText="Wallet Transactions" expandable="true" expanded="false" class="sapUiTinyMarginTop"
                    visible="{= ${wallet>/transactions}.length > 0 }">
                    <content>
                        <List items="{wallet>/transactions}" noDataText="No transactions">
                            <CustomListItem type="Active" press=".onTransactionItemPress">
                                <VBox class="sapUiSmallMargin">
                                    <!-- Main Row: Hash and Amount -->
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                                        <VBox>
                                            <Title level="H5" text="{parts: ['wallet>txHash'], formatter: '.formatter.truncateHash'}"/>
                                            <Label text="{parts: ['wallet>timestamp'], formatter: '.formatter.formatBlockTime'}" class="sapUiTinyMarginTop"/>
                                        </VBox>
                                        <HBox alignItems="Center">
                                            <core:Icon
                                                src="{= ${wallet>amount} >= 0 ? 'sap-icon://arrow-top' : 'sap-icon://arrow-bottom'}"
                                                color="{= ${wallet>amount} >= 0 ? '#107e3e' : '#bb0000'}"
                                                size="1rem"
                                                class="sapUiTinyMarginEnd"/>
                                            <ObjectNumber
                                                number="{= (${wallet>amount} >= 0 ? '+' : '') + (Math.floor(Number(${wallet>amount} || 0) / 1000000 * 100) / 100)}"
                                                unit="{= ${wallet>amount} >= 0 ? 'ADA Received' : 'ADA Sent'}"
                                                state="{= ${wallet>amount} >= 0 ? 'Success' : 'Error'}"
                                                emphasized="true"/>
                                        </HBox>
                                    </HBox>
                                    <!-- Native Assets -->
                                    <VBox visible="{wallet>hasAssets}" class="sapUiSmallMarginTop">
                                        <Title level="H6" text="Native Assets"/>
                                        <HBox items="{wallet>assets}" wrap="Wrap" class="sapUiTinyMarginTop">
                                            <ObjectStatus
                                                text="{= (Number(${wallet>quantity}) >= 0 ? '+' : '') + ${wallet>quantity} + ' ' + (${wallet>assetName} || ${wallet>policyId}.substring(0, 8) + '...')}"
                                                state="{= Number(${wallet>quantity}) >= 0 ? 'Success' : 'Error'}"
                                                icon="{= Number(${wallet>quantity}) >= 0 ? 'sap-icon://arrow-top' : 'sap-icon://arrow-bottom'}"
                                                class="sapUiSmallMarginEnd sapUiTinyMarginBottom"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </CustomListItem>
                        </List>
                    </content>
                </Panel>

                <!-- Signing Requests -->
                <Panel headerText="Signing Requests" expandable="true" expanded="false" class="sapUiTinyMarginTop"
                    visible="{= ${wallet>/signingRequests}.length > 0 }">
                    <content>
                        <List items="{wallet>/signingRequests}" noDataText="No signing requests">
                            <CustomListItem type="Active" press=".onSigningRequestItemPress">
                                <VBox class="sapUiSmallMargin">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Title level="H5" text="{= ${wallet>id} ? ${wallet>id}.substring(0, 8) + '...' + ${wallet>id}.slice(-4) : 'N/A'}"/>
                                            <Label text="{parts: ['wallet>createdAt'], formatter: '.formatter.formatTimestamp'}" class="sapUiTinyMarginTop"/>
                                        </VBox>
                                        <ObjectStatus
                                            text="{wallet>status}"
                                            state="{parts: ['wallet>status'], formatter: '.formatter.getSigningRequestStatusState'}"
                                            icon="{parts: ['wallet>status'], formatter: '.formatter.getSigningRequestStatusIcon'}"/>
                                    </HBox>
                                </VBox>
                            </CustomListItem>
                        </List>
                    </content>
                </Panel>

                <!-- Transaction Builds -->
                <Panel headerText="Transaction Builds" expandable="true" expanded="false" class="sapUiTinyMarginTop"
                    visible="{= ${wallet>/transactionBuilds}.length > 0 }">
                    <content>
                        <List items="{wallet>/transactionBuilds}" noDataText="No transaction builds">
                            <CustomListItem type="Active" press=".onTransactionBuildItemPress">
                                <VBox class="sapUiSmallMargin">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <VBox>
                                            <Title level="H5" text="{= ${wallet>id} ? ${wallet>id}.substring(0, 8) + '...' + ${wallet>id}.slice(-4) : 'N/A'}"/>
                                            <Label text="{parts: ['wallet>createdAt'], formatter: '.formatter.formatTimestamp'}" class="sapUiTinyMarginTop"/>
                                        </VBox>
                                        <ObjectNumber
                                            number="{= Math.floor(Number(${wallet>fee} || 0) / 1000000 * 100) / 100}"
                                            unit="ADA fee"
                                            state="Warning"/>
                                    </HBox>
                                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                                        <Label text="{= ${wallet>senderAddress} ? 'From: ' + ${wallet>senderAddress}.substring(0, 15) + '...' : ''}"/>
                                        <ObjectStatus
                                            text="{= ${wallet>wasSubmitted} ? 'Submitted' : 'Pending'}"
                                            state="{= ${wallet>wasSubmitted} ? 'Success' : 'None'}"/>
                                    </HBox>
                                </VBox>
                            </CustomListItem>
                        </List>
                    </content>
                </Panel>

            </VBox>
        </content>

        <footer>
            <Bar visible="{wallet>/isConnected}">
                <contentMiddle>
                    <Text text="Connected via CIP-30"/>
                </contentMiddle>
            </Bar>
        </footer>

    </Page>

</mvc:View>
