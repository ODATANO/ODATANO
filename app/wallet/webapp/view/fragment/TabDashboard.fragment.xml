<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox>
        <!-- Balance Card -->
        <Panel headerText="Balance" expandable="false" class="sapUiTinyMarginTop">
            <content>
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                    <VBox>
                        <ObjectNumber
                            number="{= Math.floor(Number(${wallet>/balance/lovelace} || 0) / 1000000 * 100) / 100 }"
                            unit="ADA"
                            emphasized="true"
                            state="Information"/>
                        <Text text="{= (${wallet>/balance/lovelace} || '0') + ' lovelace'}"/>
                    </VBox>
                    <Button
                        text="Send ADA"
                        icon="sap-icon://initiative"
                        type="Emphasized"
                        press=".onSendAda"/>
                </HBox>
            </content>
        </Panel>

        <!-- HSM Signing Module -->
        <Panel expandable="true" expanded="false"
               visible="{= ${hsm>/connected} &amp;&amp; ${wallet>/connectedVia} === 'hsm'}"
               class="sapUiTinyMarginTop">
            <headerToolbar>
                <Toolbar>
                    <Title text="HSM Signing Module" level="H5"/>
                    <ToolbarSpacer/>
                    <ObjectStatus text="Connected" state="Success" icon="sap-icon://connected"/>
                    <Button icon="sap-icon://refresh" type="Transparent" press=".onRefreshHsmStatus" tooltip="Refresh HSM Status"/>
                </Toolbar>
            </headerToolbar>
            <content>
                <VBox class="sapUiSmallMargin">
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <Label text="Key Label:" class="sapUiSmallMarginEnd"/>
                        <Text text="{hsm>/keyLabel}"/>
                    </HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <Label text="Key ID:" class="sapUiSmallMarginEnd"/>
                        <Text text="{hsm>/keyId}"/>
                    </HBox>
                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                        <Label text="Public Key Hash:" class="sapUiSmallMarginEnd"/>
                        <Text text="{parts: ['hsm>/publicKeyHash'], formatter: '.formatter.truncateHash'}"/>
                    </HBox>
                    <HBox alignItems="Center">
                        <Label text="Address:" class="sapUiSmallMarginEnd"/>
                        <Text text="{parts: ['hsm>/cardanoAddress'], formatter: '.formatter.truncateAddress'}"/>
                    </HBox>
                </VBox>
            </content>
        </Panel>

        <!-- UTxOs -->
        <Panel expandable="true" expanded="false" class="sapUiTinyMarginTop"
            headerText="{= 'UTxOs (' + (${wallet>/utxos} ? ${wallet>/utxos}.length : 0) + ')'}"
            visible="{= ${wallet>/utxos} &amp;&amp; ${wallet>/utxos}.length > 0}">
            <content>
                <List items="{wallet>/utxos}" noDataText="No UTxOs">
                    <CustomListItem type="Active" press=".onToggleUtxoDetail">
                        <VBox class="sapUiSmallMargin">
                            <!-- Summary row -->
                            <HBox alignItems="Center" justifyContent="SpaceBetween">
                                <HBox alignItems="Center">
                                    <core:Icon
                                        src="{= ${wallet>expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow'}"
                                        size="0.85rem" class="sapUiSmallMarginEnd" color="#6a6d70"/>
                                    <Text text="{parts: ['wallet>hash'], formatter: '.formatter.truncateHash'}"
                                        class="signingFlowMono"/>
                                    <Text text="{= '#' + ${wallet>index}}" class="sapUiTinyMarginBegin walletConnectHint"/>
                                </HBox>
                                <HBox alignItems="Center">
                                    <ObjectStatus text="{= ${wallet>assets} &amp;&amp; ${wallet>assets}.length > 0 ? ${wallet>assets}.length + ' asset(s)' : ''}"
                                        state="Information" class="sapUiSmallMarginEnd"
                                        visible="{= ${wallet>assets} &amp;&amp; ${wallet>assets}.length > 0}"/>
                                    <ObjectNumber
                                        number="{path: 'wallet>lovelace', formatter: '.formatter.formatLovelaceToAda'}"
                                        unit="ADA"/>
                                </HBox>
                            </HBox>
                            <!-- Expanded detail -->
                            <VBox visible="{wallet>expanded}" class="dashboardItemDetail">
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <Label text="Tx Hash:" class="sapUiSmallMarginEnd"/>
                                    <Text text="{wallet>hash}" class="signingFlowMono" wrapping="true"/>
                                    <Button icon="sap-icon://copy" press=".onCopyUtxoHash"
                                        type="Transparent" class="copyInline" tooltip="{i18n>copy}"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <Label text="Output Index:" class="sapUiSmallMarginEnd"/>
                                    <Text text="{wallet>index}"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <Label text="Lovelace:" class="sapUiSmallMarginEnd"/>
                                    <Text text="{wallet>lovelace}" class="signingFlowMono"/>
                                </HBox>
                                <!-- Assets detail -->
                                <VBox visible="{= ${wallet>assets} &amp;&amp; ${wallet>assets}.length > 0}"
                                    class="sapUiTinyMarginTop">
                                    <Label text="Assets:" class="sapUiTinyMarginBottom"/>
                                    <List items="{wallet>assets}" class="dashboardSubList">
                                        <CustomListItem>
                                            <HBox alignItems="Center" justifyContent="SpaceBetween"
                                                class="sapUiTinyMargin">
                                                <VBox>
                                                    <Text text="{= ${wallet>asset_assetName} || '(unnamed)'}"
                                                        class="sapUiTinyMarginBottom"/>
                                                    <Text text="{parts: ['wallet>asset_policyId'], formatter: '.formatter.truncateHash'}"
                                                        class="signingFlowMono walletConnectHint"/>
                                                </VBox>
                                                <ObjectNumber number="{wallet>asset_quantity}" unit="units"/>
                                            </HBox>
                                        </CustomListItem>
                                    </List>
                                </VBox>
                            </VBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </content>
        </Panel>

        <!-- Native Assets -->
        <Panel expandable="true" expanded="false" class="sapUiTinyMarginTop"
            headerText="{= 'Native Assets (' + (${wallet>/assetsSummary} ? ${wallet>/assetsSummary}.length : 0) + ')'}"
            visible="{= ${wallet>/assetsSummary} &amp;&amp; ${wallet>/assetsSummary}.length > 0}">
            <content>
                <List items="{wallet>/assetsSummary}" noDataText="No native assets">
                    <CustomListItem>
                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                            <VBox>
                                <Text text="{wallet>displayName}" class="sapUiTinyMarginBottom"/>
                                <Text text="{parts: ['wallet>policyId'], formatter: '.formatter.truncateHash'}"
                                    class="signingFlowMono walletConnectHint"/>
                            </VBox>
                            <ObjectNumber number="{wallet>quantity}" unit="units" emphasized="true"/>
                        </HBox>
                    </CustomListItem>
                </List>
            </content>
        </Panel>

        <!-- Recent Transactions -->
        <Panel expandable="true" expanded="false" class="sapUiTinyMarginTop"
            headerText="{= 'Recent Transactions (' + (${wallet>/transactions} ? ${wallet>/transactions}.length : 0) + ')'}"
            visible="{= ${wallet>/transactions} &amp;&amp; ${wallet>/transactions}.length > 0}">
            <content>
                <List items="{wallet>/transactions}" noDataText="No transactions">
                    <CustomListItem type="Active" press=".onToggleTxDetail">
                        <VBox class="sapUiSmallMargin">
                            <!-- Summary row -->
                            <HBox alignItems="Center" justifyContent="SpaceBetween">
                                <HBox alignItems="Center">
                                    <core:Icon
                                        src="{= ${wallet>expanded} ? 'sap-icon://navigation-down-arrow' : 'sap-icon://navigation-right-arrow'}"
                                        size="0.85rem" class="sapUiSmallMarginEnd" color="#6a6d70"/>
                                    <Text text="{parts: ['wallet>txHash'], formatter: '.formatter.truncateHash'}"
                                        class="signingFlowMono"/>
                                </HBox>
                                <HBox alignItems="Center">
                                    <ObjectStatus text="{= ${wallet>hasAssets} ? 'assets' : ''}"
                                        state="Information" class="sapUiSmallMarginEnd"
                                        visible="{wallet>hasAssets}"/>
                                    <ObjectNumber
                                        number="{path: 'wallet>amount', formatter: '.formatter.formatLovelaceToAda'}"
                                        unit="ADA"
                                        state="{= Number(${wallet>amount} || 0) >= 0 ? 'Success' : 'Error'}"/>
                                </HBox>
                            </HBox>
                            <!-- Expanded detail -->
                            <VBox visible="{wallet>expanded}" class="dashboardItemDetail">
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <Label text="Tx Hash:" class="sapUiSmallMarginEnd"/>
                                    <Text text="{wallet>txHash}" class="signingFlowMono" wrapping="true"/>
                                    <Button icon="sap-icon://copy" press=".onCopyTxHash"
                                        type="Transparent" class="copyInline" tooltip="Copy"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <Label text="Time:" class="sapUiSmallMarginEnd"/>
                                    <Text text="{path: 'wallet>timestamp', formatter: '.formatter.formatBlockTime'}"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <Label text="Net Amount:" class="sapUiSmallMarginEnd"/>
                                    <Text text="{= (${wallet>amount} || '0') + ' lovelace'}" class="signingFlowMono"/>
                                </HBox>
                                <Button text="View Details" icon="sap-icon://detail-view"
                                    type="Transparent" press=".onTransactionItemPress"
                                    class="sapUiTinyMarginTop"/>
                            </VBox>
                        </VBox>
                    </CustomListItem>
                </List>
            </content>
        </Panel>

    </VBox>
</core:FragmentDefinition>
