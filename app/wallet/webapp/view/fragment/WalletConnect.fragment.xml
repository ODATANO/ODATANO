<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <!-- Wallet Connect Panel — shown when no wallet is connected -->
    <VBox
        alignItems="Center"
        visible="{= !${wallet>/isConnected}}"
        class="walletConnectPanel">

        <Image
            src="img/logo.svg"
            width="400px"
            class="sapUiMediumMarginBottom"/>

        <!-- Connecting indicator -->
        <BusyIndicator
            text="Connecting to wallet..."
            visible="{wallet>/isConnecting}"
            class="sapUiMediumMarginTop"/>

        <!-- Error display -->
        <MessageStrip
            text="{wallet>/error}"
            type="Error"
            showIcon="true"
            showCloseButton="true"
            visible="{= !!${wallet>/error}}"
            class="sapUiSmallMarginBottom walletConnectFullWidth"/>

        <!-- Browser Wallets Section -->
        <VBox visible="{= !${wallet>/isConnecting}}" class="walletConnectFullWidth">

            <Label text="Browser Wallet" design="Bold" class="sapUiTinyMarginBottom"/>

            <List
                items="{wallet>/availableWallets}"
                mode="SingleSelectMaster"
                selectionChange=".onWalletSelect"
                noDataText="No Cardano wallets detected. Install Eternl, Lace or Nami."
                class="walletConnectList">
                <CustomListItem type="Active" class="walletConnectItem">
                    <HBox alignItems="Center" class="walletConnectItemContent">
                        <Image
                            src="{wallet>icon}"
                            width="28px"
                            height="28px"
                            class="sapUiSmallMarginEnd"
                            visible="{= !!${wallet>icon}}"/>
                        <Text text="{wallet>name}"/>
                    </HBox>
                </CustomListItem>
            </List>

            <!-- HSM Option -->
            <VBox visible="{= !${hsm>/loading} &amp;&amp; ${hsm>/connected}}"
                class="sapUiSmallMarginTop">
                <Label text="Hardware Security Module" design="Bold" class="sapUiTinyMarginBottom"/>
                <List class="walletConnectList">
                    <CustomListItem type="Active" press=".onHsmConnect" class="walletConnectItem">
                        <HBox alignItems="Center" justifyContent="SpaceBetween"
                            class="walletConnectItemContent" width="100%">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://key" size="1.2rem"
                                    class="sapUiSmallMarginEnd" color="#107e3e"/>
                                <VBox>
                                    <Text text="HSM ({hsm>/keyLabel})"/>
                                    <Text text="{parts: ['hsm>/cardanoAddress'], formatter: '.formatter.truncateAddress'}"
                                        class="walletConnectHint"/>
                                </VBox>
                            </HBox>
                            <core:Icon src="sap-icon://accept" color="#107e3e"/>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>

            <!-- HSM Loading -->
            <BusyIndicator
                text="Checking HSM..."
                visible="{= ${hsm>/loading}}"
                class="sapUiSmallMarginTop"/>

            <!-- Divider -->
            <HBox alignItems="Center" justifyContent="Center"
                class="walletConnectDividerRow">
                <VBox class="walletConnectDivider"/>
                <Text text="or" class="walletConnectOrText"/>
                <VBox class="walletConnectDivider"/>
            </HBox>

            <!-- Manual Address -->
            <Label text="External Signing" design="Bold" class="sapUiTinyMarginBottom"/>
            <Text text="Paste an address to build transactions for CLI or hardware wallet signing."
                class="walletConnectHint sapUiTinyMarginBottom"/>
            <HBox alignItems="Center">
                <Input value="{wallet>/manualAddress}"
                    placeholder="addr_test1q... or addr1q..."
                    width="100%"
                    class="signingFlowMono sapUiSmallMarginEnd"
                    submit=".onManualAddressConnect"/>
                <Button text="Connect" icon="sap-icon://arrow-right"
                    type="Emphasized" press=".onManualAddressConnect"/>
            </HBox>
        </VBox>
    </VBox>

</core:FragmentDefinition>
