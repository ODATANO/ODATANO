# ODATANO Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Cardano Network Configuration
# ============================================
# Supported values: mainnet, preview, preprod
NETWORK=preview

# ============================================
# Backend Configuration
# ============================================
# Available backends (comma-separated): blockfrost, koios, ogmios
# Example: blockfrost,koios,ogmios or just blockfrost
BACKENDS=blockfrost,koios,ogmios

# ============================================
# Transaction Builders Configuration
# ============================================
# Available builders (comma-separated): csl, buildooor
# Example: csl,buildooor or just csl
TX_BUILDERS=csl,buildooor

# ============================================
# Blockfrost Configuration
# ============================================
# Get your API key from https://blockfrost.io
BLOCKFROST_KEY=your_blockfrost_api_key_here


# ============================================
# Ogmios Configuration
# ============================================
# Ogmios WebSocket URL
OGMIOS_URL=ws://localhost:1337


# ============================================
# Application Configuration
# ============================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# Service port (default: 4004)
PORT=4004

# ============================================
# Cache Configuration (Optional)
# ============================================
# TTL for cached data in milliseconds (default: 600000 = 10 minutes)
INDEX_TTL_MS=600000
