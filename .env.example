# ODATANO Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Cardano Network Configuration
# ============================================
# Supported values: mainnet, preview, preprod
CARDANO_NETWORK=preview

# ============================================
# Provider Configuration
# ============================================
# Primary provider: blockfrost or koios
CARDANO_PROVIDER=blockfrost

# ============================================
# Blockfrost Configuration
# ============================================
# Get your API key from https://blockfrost.io
# Free tier: 50,000 requests/day
BLOCKFROST_API_KEY=your-blockfrost-api-key-here

# ============================================
# Koios Configuration (Optional Fallback)
# ============================================
# Koios is used as fallback if Blockfrost fails
# Default: https://api.koios.rest/api/v1
# KOIOS_API_URL=https://api.koios.rest/api/v1

# ============================================
# Application Configuration
# ============================================
# Log level: error, warn, info, debug, trace
CDS_LOG_LEVEL=info

# Node environment
NODE_ENV=development

# Service port (default: 4004)
PORT=4004

# ============================================
# Database Configuration
# ============================================
# SQLite database path (optional)
# DB_PATH=/app/data/db.sqlite

# ============================================
# Cache Configuration (Optional)
# ============================================
# TTL for cached data in milliseconds (default: 60000 = 1 minute)
# INDEX_TTL_MS=60000

# ============================================
# Rate Limiting (Optional)
# ============================================
# Maximum requests per window
# RATE_LIMIT_MAX_REQUESTS=100
# Rate limit window in milliseconds
# RATE_LIMIT_WINDOW_MS=60000