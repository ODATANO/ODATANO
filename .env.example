# ODATANO Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Application Configuration
# ============================================
# Cardano Network: Supported values: mainnet, preview, preprod
NETWORK=preview
# Debug output for single modules (cds.log), e.g. DEBUG=CardanoService
# DEBUG=
# Node environment
NODE_ENV=development
# Service port (default: 4004)
PORT=4004

# ============================================
# Backend Configuration
# ============================================
# Available backends (comma-separated): koios, ogmios, blockfrost, odatano
# Example: ogmios,koios with a local node, or just koios (no account needed)
BACKENDS=koios

# ============================================
# Koios Configuration
# ============================================
# Works without a token on the public tier. A token from https://koios.rest raises the rate limit.
#KOIOS_API_KEY=

# ============================================
# Blockfrost Configuration (optional backend)
# ============================================
# Get your API key from https://blockfrost.io
#BLOCKFROST_API_KEY=

# Optional: point at a self-hosted Blockfrost-compatible node (Dolos MiniBF,
# Demeter Self-Hosted, etc.) instead of api.blockfrost.io. When set,
# BLOCKFROST_API_KEY becomes optional.
# Examples:
#   Dolos MiniBF:        http://localhost:3010/api/v0
#   Demeter Self-Hosted: https://blockfrost-<project>.demeter.run/api/v0
#BLOCKFROST_CUSTOM_BACKEND=

# ============================================
# Ogmios Configuration
# ============================================
# Ogmios WebSocket URL
OGMIOS_URL=ws://localhost:1337

# ============================================
# Cache Configuration (Optional)
# ============================================
# How long a stored address, account, pool, DRep or asset answers before it is read again,
# in milliseconds (default: 3600000 = 1 hour)
# INDEX_TTL_MS=3600000

# ============================================
# Agent grants (optional, off by default)
# ============================================
# true: an Admin issues scoped tokens (odat_...) with CardanoAgentService.CreateAgentGrant.
# A request with the header x-agent-token runs as agent:<grantId>, limited to the grant's
# allow list and daily budget. Requests without the header use the configured CAP login.
# docs/guides/USER_GUIDE.md, section "Agent Grants", has the details.
#AGENT_GRANTS_ENABLED=false
# CAP auth kind that authenticates requests without a token. Default: cds.requires.auth.kind.
# One of: mocked, basic, jwt, xsuaa, ias, dummy
#AGENT_GRANTS_DELEGATE=mocked
# Grant administration calls per principal per hour (default 10)
#AGENT_GRANT_ADMIN_RATE_LIMIT=10
# How long a resolved token is reused before the database is read again, in ms (default 10000, 0 = off).
# A revoke or rotate takes effect at once on this process, on another replica after at most this long.
#AGENT_TOKEN_CACHE_MS=10000
# Usage counters older than this many days are deleted once a day (default 400, 0 = keep all)
#AGENT_GRANT_USAGE_RETENTION_DAYS=400

# ============================================
# Wallet worker keys (optional)
# ============================================
# Secret that encrypts software signing keys given as iv:authTag:ciphertext.
# Required in production when such a key is used.
#ENCRYPTION_KEY=

# ============================================
# HSM Configuration (optional)
# ============================================
# Enable HSM support (true/false)
#HSM_ENABLED=false
# Role a caller needs for the HSM actions; required when HSM_ENABLED=true
#HSM_REQUIRES_ROLE=
# Path to the PKCS#11 module, for example SoftHSM2's libsofthsm2.so
#HSM_PKCS11_MODULE=
# HSM slot number
#HSM_SLOT=0
# HSM user PIN; from a credential store in production
#HSM_PIN=
# HSM key label, or HSM_KEY_ID
#HSM_KEY_LABEL=cardano-signing-key

# ============================================
# Docker image (docker compose reads these from .env)
# ============================================
# Password of the operator user; required
#ODATANO_HTTP_PASSWORD=
# Number of reverse proxies in front of the container (0 to 10). Needs @odatano/cap-auth 0.2.0.
# The port must then be reachable only through the proxy.
#ODATANO_TRUST_PROXY=0
