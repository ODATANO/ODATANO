# ODATANO Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Cardano Network Configuration
# ============================================
# Supported values: mainnet, preview, preprod
NETWORK=preview

# ============================================
# Backend Configuration
# ============================================
# Available backends: hybrid, ogmios, blockfrost, koios
# 
# Recommended: hybrid (Ogmios for live data + Blockfrost/Koios for history)
# - Uses self-hosted Node for critical operations (TX submit, UTxOs)
# - Uses external API only for historical blocks/transactions
# - No 15GB cardano-db-sync duplication needed
#
# Options:
# - hybrid: Ogmios (live) + Blockfrost/Koios (historical) - RECOMMENDED
# - ogmios: Ogmios only (no historical block/TX queries)
# - blockfrost: Blockfrost only (no self-hosted node needed)
# - koios: Koios only (free, no API key)
# - Multiple: hybrid,blockfrost,koios (fallback chain)
#
BACKENDS=hybrid

# ============================================
# Ogmios Configuration (required for hybrid/ogmios modes)
# ============================================
# WebSocket URL to your Ogmios server
# Local Docker: ws://localhost:1337
# Docker Compose: ws://ogmios:1337
OGMIOS_URL=ws://localhost:1337

# ============================================
# Blockfrost Configuration (for hybrid/blockfrost modes)
# ============================================
# Get your API key from https://blockfrost.io
# Leave empty to use Koios as historical backend in hybrid mode
BLOCKFROST_KEY=your-blockfrost-api-key-here

# ============================================
# Application Configuration
# ============================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# Service port (default: 4004)
PORT=4004

# ============================================
# Cache Configuration (Optional)
# ============================================
# TTL for cached data in milliseconds (default: 60000 = 1 minute)
INDEX_TTL_MS=60000
