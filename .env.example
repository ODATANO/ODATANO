# ODATANO Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Cardano Network Configuration
# ============================================
# Supported values: mainnet, preview, preprod
NETWORK=preview

# ============================================
# Backend Configuration
# ============================================
# Available backends (comma-separated): blockfrost, koios
# Example: blockfrost,koios or just blockfrost
BACKENDS=blockfrost,koios

# ============================================
# Blockfrost Configuration
# ============================================
# Get your API key from https://blockfrost.io
BLOCKFROST_KEY=your-blockfrost-api-key-here


# ============================================
# Application Configuration
# ============================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# Service port (default: 4004)
PORT=4004

# ============================================
# Cache Configuration (Optional)
# ============================================
# TTL for cached data in milliseconds (default: 60000 = 1 minute)
INDEX_TTL_MS=60000
