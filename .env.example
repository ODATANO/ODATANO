# ODATANO Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Application Configuration
# ============================================
# Cardano Network: Supported values: mainnet, preview, preprod
NETWORK=preview
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info
# Node environment
NODE_ENV=development
# Service port (default: 4004)
PORT=4004

# ============================================
# Backend Configuration
# ============================================
# Available backends (comma-separated): blockfrost, koios, ogmios
# Example: blockfrost,koios,ogmios or just blockfrost
BACKENDS=koios,ogmios

# ============================================
# Transaction Builders Configuration
# ============================================
# Available builders (comma-separated): csl, buildooor
# Example: csl,buildooor or just csl
TX_BUILDERS='buildooor,csl'
# ============================================
# Blockfrost Configuration
# ============================================
# Get your API key from https://blockfrost.io
#BLOCKFROST_KEY=your_blockfrost_key_here

# ============================================
# Koios Configuration
# ============================================
# Get your API key from https://koios.rest (optional but recommended)
#KOIOS_API_KEY=your_koios_jwt_token_here
BLOCKFROST_KEY=your_blockfrost_api_key_here

# ============================================
# Ogmios Configuration
# ============================================
# Ogmios WebSocket URL
OGMIOS_URL=ws://localhost:1337

# ============================================
# Cache Configuration (Optional)
# ============================================
# TTL for cached data in milliseconds (default: 600000 = 10 minutes)
INDEX_TTL_MS=600000

## ============================================
# HSM Configuration (Optional)
## ============================================
# Enable HSM support (true/false)
HSM_ENABLED=true
# Path to SoftHSM2 configuration file
SOFTHSM2_CONF= /path/to/softhsm2.conf
# Path to PKCS#11 module (SoftHSM2)
HSM_PKCS11_MODULE=/usr/lib/softhsm/libsofthsm2.so
# HSM slot number
HSM_SLOT=0
# HSM user PIN
HSM_PIN=1234 
# HSM key label
HSM_KEY_LABEL=cardano-signing-key