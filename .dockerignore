# Node modules — recursive: nested installs (app/router, app/wallet, …) would
# otherwise bloat the build context and break on .bin symlinks under Windows.
**/node_modules
npm-debug.log
yarn-error.log

# Build artifacts (but keep generated CDS models)
dist/
build/
*.log

# Test files
test/
*.test.ts
*.test.js
coverage/

# Development files
.git/
.gitignore
.github/
.vscode/
.idea/

# Environment files (should be provided at runtime)
**/.env*
!.env.example
**/default-env.json

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Documentation
docs/
*.md
!README.md

# Scripts that aren't needed in production
# scripts/

# SQLite databases (will be created in container)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Jest
jest.config.*

# ESLint config
eslint.config.*
.eslintrc*

# Code coverage
codecov.yml

# Local keys, notes and deploy artifacts
payment.*
**/*.skey
**/*.vkey
**/*.key
**/*.pem
**/*.p12
**/*seed*
**/*mnemonic*
**/*.local.*
.claude/
local_docs/
scratch/
repro*/
output/
gen/
mtx/
scripts/perf/*results*.json
mta_archives/
mta-op-*/
*.mtaext

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore


upstream-bugs/