{
  "name": "@odatano/core",
  "version": "2.0.0",
  "description": "SAP CAP plugin for Cardano blockchain OData V4 integration",
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "cds-plugin.js",
    "src/**/*.js",
    "src/**/*.d.ts",
    "srv/**/*.js",
    "srv/**/*.d.ts",
    "srv/**/*.cds",
    "db/**/*.cds",
    "@cds-models/"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "peerDependencies": {
    "@sap/cds": ">=10"
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "~6.0.0",
    "@cap-js/hana": "^3",
    "@cardano-ogmios/client": "^6.14.0",
    "@harmoniclabs/buildooor": "0.2.9",
    "@harmoniclabs/cardano-costmodels-ts": "~1.6.1",
    "@harmoniclabs/cardano-ledger-ts": "^0.5.6",
    "@harmoniclabs/cbor": "^2.0.1",
    "@harmoniclabs/crypto": "^0.3.0",
    "@harmoniclabs/uint8array-utils": "^1.0.4",
    "@sap/xssec": "^4",
    "axios": "^1.18.0",
    "bech32": "^2.0.0",
    "blake2b": "^2.1.4"
  },
  "optionalDependencies": {
    "pkcs11js": "^2.1.6"
  },
  "overrides": {
    "axios": "^1.18.0",
    "esbuild": "0.28.1",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.5",
    "ws": "7.5.11",
    "@sap/approuter": {
      "body-parser": "^2.2.3"
    }
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/cds-typer": "^0.40.0",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "@sap/cds-dk": "^10",
    "@sap/eslint-plugin-cds": "^4.2.4",
    "@types/blake2b": "^2.1.3",
    "@types/node": "^22.19.7",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.2",
    "nock": "^13.5.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "cds": {
    "typer": {
      "ieee754compatible": true
    },
    "build": {
      "tasks": [
        {
          "for": "node-cf",
          "src": "srv",
          "dest": "../gen/srv"
        },
        {
          "for": "hana",
          "src": "db",
          "dest": "../gen/db"
        }
      ]
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana",
          "pool": {
            "acquireTimeoutMillis": 30000,
            "min": 0,
            "max": 10
          }
        },
        "auth": "xsuaa"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.globSync('{srv,db,src}/**/*.{js,js.map,d.ts,d.ts.map}').filter(f=>!f.includes('node_modules')).forEach(f=>fs.unlinkSync(f));console.log('Clean complete')\"",
    "clean:models": "node -e \"require('fs').rmSync('@cds-models',{recursive:true,force:true});console.log('Removed @cds-models')\"",
    "build": "npm run cds:types && tsc",
    "build:plugin": "npm run cds:types && tsc -p tsconfig.build.json",
    "build:package": "npm run clean && npm run clean:models && npm run build:plugin",
    "prepare": "npm run build:package",
    "start": "cds-serve",
    "cds:watch": "cds watch",
    "cds:serve": "cds serve --with-mocks",
    "cds:types": "cds-typer \"*\" --outputDirectory @cds-models",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:deploy": "cds deploy",
    "pretest": "npm run clean && npm run cds:types && npm run db:deploy",
    "test": "vitest run",
    "pretest:coverage": "npm run clean && npm run cds:types && npm run db:deploy",
    "test:coverage": "vitest run --coverage",
    "pretest:ci": "npm run clean && npm run cds:types && npm run db:deploy",
    "test:ci": "vitest run --exclude \"**/core-ogmios.test.ts\"",
    "pretest:ci:coverage": "npm run clean && npm run cds:types && npm run db:deploy",
    "test:ci:coverage": "vitest run --coverage --exclude \"**/core-ogmios.test.ts\"",
    "pretest:integration": "npm run clean && npm run cds:types && npm run db:deploy",
    "test:integration": "vitest run --project integration",
    "test:integration:blockfrost": "vitest run test/integration/core.blockfrost.test.ts",
    "test:integration:koios": "vitest run test/integration/core.koios.test.ts",
    "test:integration:ogmios": "vitest run test/integration/core-ogmios.test.ts",
    "test:integration:both": "npm run test:integration:blockfrost && npm run test:integration:koios",
    "pretest:unit": "npm run cds:types",
    "test:unit": "vitest run --project unit",
    "watch-odatano": "cds watch --open odatano/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-wallet": "cds watch --open wallet/webapp/index.html"
  },
  "workspaces": [
    "app/router"
  ],
  "sapux": [
    "app/odatano"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/ODATANO.git"
  },
  "keywords": [
    "CAP",
    "CDS",
    "plugin",
    "Cardano",
    "blockchain",
    "OData",
    "SAP"
  ],
  "author": "Maximilian Weber",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ODATANO/ODATANO/issues"
  },
  "homepage": "https://github.com/ODATANO/ODATANO#readme"
}
