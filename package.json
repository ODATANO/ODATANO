{
  "name": "odatano",
  "version": "0.1.0",
  "description": "A SAP CAP service for interacting with Cardano blockchain data.",
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "^6.0.0",
    "@cap-js/sqlite": "^2",
    "@cardano-ogmios/client": "^6.14.0",
    "@emurgo/cardano-serialization-lib-nodejs": "^15.0.3",
    "@harmoniclabs/buildooor": "^0.1.21",
    "@odatano/watch": "0.1.0",
    "@sap/cds": "^9",
    "axios": "^1.13.2",
    "bech32": "^2.0.0",
    "dotenv": "^16.3.1",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/cds-typer": "^0.38.0",
    "@cap-js/cds-types": "^0.15.0",
    "@sap/cds-dk": "^9.4.3",
    "@types/blake2b": "^2.1.3",
    "@types/jest": "^29.5.14",
    "@types/nock": "^10.0.3",
    "@types/node": "^22.19.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "cds-plugin-ui5": "^0.13.0",
    "eslint": "^9.39.2",
    "jest": "^29.6.1",
    "mock-socket": "^9.3.1",
    "nock": "^14.0.10",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@sap/eslint-plugin-cds": "^4"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "cardanoWatcher": {
        "kind": "cardano-watcher",
        "network": "preview",
        "apiKey": "${env:BLOCKFROST_KEY}"
      }
    },
    "plugins": {
      "@odatano/watch": {}
    },
    "deploy": {
      "data": false
    }
  },
  "scripts": {
    "build": "npm run cds:types && tsc",
    "start": "cds-serve",
    "cds:watch": "cds watch",
    "cds:serve": "cds serve --with-mocks",
    "cds:types": "cds-typer \"*\" --outputDirectory @cds-models",
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:deploy": "cds deploy",
    "pretest": "npm run cds:types && npm run db:deploy",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:ci": "jest --runInBand --testPathIgnorePatterns=core-ogmios.test.ts",
    "test:ci:coverage": "jest --runInBand --coverage --testPathIgnorePatterns=core-ogmios.test.ts",
    "test:integration": "npm test -- --testPathPattern=integration",
    "test:integration:blockfrost": "npm test -- --testPathPattern=core.blockfrost.test.ts",
    "test:integration:koios": "npm test -- --testPathPattern=core.koios.test.ts",
    "test:integration:ogmios": "npm test -- --testPathPattern=core-ogmios.test.ts",
    "test:integration:both": "npm run test:integration:blockfrost && npm run test:integration:koios",
    "test:unit": "npm test -- --testPathPattern=unit",
    "watch-odatano": "cds watch --open odatano/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/odatano"
  ],
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/ODATANO.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ODATANO/ODATANO/issues"
  },
  "homepage": "https://github.com/ODATANO/ODATANO#readme"
}
