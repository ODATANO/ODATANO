{
  "name": "odatano",
  "version": "1.0.0",
  "description": "A SAP CAP service for interactting with Cardano blockchain data.",
  "dependencies": {
    "@blockfrost/blockfrost-js": "^6.0.0",
    "@sap/cds": "^9",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "express": "^4",
    "node-cache": "^5.1.2",
    "pino": "^8.13.0",
    "redis": "^5.9.0"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.38.0",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@sap/cds-dk": "^9.4.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.6.1",
    "nyc": "^15.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "scripts": {
    "start": "cds-serve",
    "cds:watch": "cds watch",
    "cds:serve": "cds serve --with-mocks",
    "test": "jest --runInBand",
    "test:coverage": "nyc npm test",
    "test:integration": "npm test -- --testPathPattern=integration",
    "test:unit": "npm test -- --testPathPattern=unit"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
