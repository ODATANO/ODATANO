{
  "name": "odatano",
  "version": "1.0.0",
  "description": "A SAP CAP service for interacting with Cardano blockchain data.",
  "dependencies": {
    "@blockfrost/blockfrost-js": "^6.0.0",
    "@sap/cds": "^9",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "express": "^4",
    "pino": "^8.13.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/cds-typer": "^0.38.0",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9.4.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.6.1",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    }
  },
  "scripts": {
    "start": "cds-serve",
    "cds:watch": "cds watch",
    "cds:serve": "cds serve --with-mocks",
    "cds:types": "cds-typer \"*\" --outputDirectory @cds-models",
    "typecheck": "tsc --noEmit",
    "db:deploy": "cds deploy",
    "pretest": "npm run cds:types && npm run db:deploy",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:integration": "npm test -- --testPathPattern=integration",
    "test:unit": "npm test -- --testPathPattern=unit"
  }
}
