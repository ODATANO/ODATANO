{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "isolatedModules": false,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "allowJs": true,
    "types": ["node", "jest"],
    "paths": {
      "@sap/cds": [
        "./node_modules/@cap-js/cds-types"
      ],
      "#cds-models/*": [
        "./@cds-models/*"
      ]
    }
  },
  "include": [
    "srv/**/*.ts",
    "app/**/*.ts",
    "db/**/*.ts",
    "types/**/*.d.ts",
    "test/**/*.ts"
, "config/config.ts"  ]
}
